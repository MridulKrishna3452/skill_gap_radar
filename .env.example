# Copy to .env and fill in. Never commit .env.
# Values below are local-development placeholders only.

ENV=development
LOG_LEVEL=INFO

# Postgres (docker compose service "db")
POSTGRES_USER=skillradar
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=skillradar
DATABASE_URL=postgresql+asyncpg://skillradar:change-me-local-only@localhost:5432/skillradar

# Redis (docker compose service "redis")
REDIS_URL=redis://localhost:6379/0

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000

# Auth (P1). Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=

# LLM (P7/P11). Leave empty until those phases.
ANTHROPIC_API_KEY=
