# Copy to .env and fill in. Never commit .env.
# Values below are local-development placeholders only.

ENV=development
LOG_LEVEL=INFO

# Host ports published by docker compose (defaults avoid a locally installed
# Postgres on 5432 / Redis on 6379). DATABASE_URL / REDIS_URL below must match.
DB_HOST_PORT=5433
REDIS_HOST_PORT=6380
API_HOST_PORT=8000

# Use 127.0.0.1, not "localhost": on Windows "localhost" resolves to IPv6 ::1 first, and
# the refused IPv6 attempt adds ~2s to every new connection.

# Postgres (docker compose service "db")
POSTGRES_USER=skillradar
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=skillradar
DATABASE_URL=postgresql+asyncpg://skillradar:change-me-local-only@127.0.0.1:5433/skillradar

# Redis (docker compose service "redis")
REDIS_URL=redis://127.0.0.1:6380/0

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000

# Auth (P1). Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=

# LLM (P7/P11). Leave empty until those phases.
ANTHROPIC_API_KEY=
