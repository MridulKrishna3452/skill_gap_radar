# Copy to .env and fill in. Never commit .env.
# Values below are local-development placeholders only.

ENV=development
LOG_LEVEL=INFO

# Host ports published by docker compose (defaults avoid a locally installed
# Postgres on 5432 / Redis on 6379). DATABASE_URL / REDIS_URL below must match.
DB_HOST_PORT=5433
REDIS_HOST_PORT=6380
API_HOST_PORT=8000

# Use 127.0.0.1, not "localhost": on Windows "localhost" resolves to IPv6 ::1 first, and
# the refused IPv6 attempt adds ~2s to every new connection.

# Postgres (docker compose service "db")
POSTGRES_USER=skillradar
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=skillradar
DATABASE_URL=postgresql+asyncpg://skillradar:change-me-local-only@127.0.0.1:5433/skillradar

# Redis (docker compose service "redis")
REDIS_URL=redis://127.0.0.1:6380/0

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000

# Adzuna job search API (Phase 1 ingestion). Free key: https://developer.adzuna.com
# Leave empty to disable the connector.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Auth (Phase 2; see docs/security.md). Required in production (32+ characters). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Left empty in development, the API uses a random per-process secret (sessions end on restart).
JWT_SECRET=
# Optional overrides (defaults shown):
# ACCESS_TOKEN_MINUTES=15
# REFRESH_TOKEN_DAYS=14
# REFRESH_FAMILY_MAX_DAYS=30
# ALLOW_REGISTRATION=true
# LOGIN_MAX_FAILURES=5
# LOCKOUT_MINUTES=15
# Rate limits as <count>/<seconds>:
# RATE_LIMIT_LOGIN=5/60
# RATE_LIMIT_LOGIN_IP=20/3600
# RATE_LIMIT_REGISTER=5/3600
# RATE_LIMIT_REFRESH=30/60
# RATE_LIMIT_EXPENSIVE=30/60
# RATE_LIMIT_PUBLIC=120/60
# Comma-separated proxy IPs whose X-Forwarded-For is trusted (only behind a load balancer):
# TRUSTED_PROXIES=
# The refresh cookie is Secure; browsers accept that on http://localhost. Only for other plain-http
# hosts in development, set COOKIE_SECURE=false (refused in production).
# COOKIE_SECURE=true

# LLM (P7/P11). Leave empty until those phases.
ANTHROPIC_API_KEY=
